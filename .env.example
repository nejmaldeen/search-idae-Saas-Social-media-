# Copy to .env and fill in what you have. NEVER commit .env.
# Every key is optional: the system reports exactly which platforms each one
# unlocks, and refuses to pretend a source works without its credentials.

# ---------------------------------------------------------------------------
# Commercial data provider — unlocks TikTok, Instagram, Snapchat, X, Reddit
# Sign up: https://console.apify.com/sign-up  (free tier includes $5 credit)
# Token:   https://console.apify.com/settings/integrations
# Measured cost on this project: ~$0.68 per 1,000 items.
# ---------------------------------------------------------------------------
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# YouTube Data API v3 — free within 10,000 quota units/day
# Enable:      https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Create key:  https://console.cloud.google.com/apis/credentials
# Costs: search.list 100 units, videos.list 1, commentThreads.list 1.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: raise rate limits on the keyless sources
# ---------------------------------------------------------------------------
GITHUB_API_TOKEN=          # search 10/min -> 30/min
STACKEXCHANGE_KEY=         # 300/day -> 10,000/day

# ---------------------------------------------------------------------------
# Override provider actors when one is deprecated (they change often).
# Example: ODA_ACTOR_REDDIT=someone~new-reddit-actor
# ---------------------------------------------------------------------------
# ODA_ACTOR_TIKTOK=
# ODA_ACTOR_INSTAGRAM=
# ODA_ACTOR_SNAPCHAT=
# ODA_ACTOR_X=
# ODA_ACTOR_REDDIT=
# ODA_COMMENT_ACTOR_TIKTOK=
# ODA_COMMENT_ACTOR_INSTAGRAM=
# ODA_PROVIDER_BASE=https://api.apify.com/v2
# ODA_ACTOR_TIMEOUT=180

# ---------------------------------------------------------------------------
# Where the SQLite database lives (default: ./data/oda.sqlite3)
# ---------------------------------------------------------------------------
# ODA_DB=./data/oda.sqlite3

# ---------------------------------------------------------------------------
# Official platform APIs. NOT needed when APIFY_TOKEN is set, and mostly not
# obtainable by a commercial operator anyway (verified Nov 2026):
#   TikTok Research API  - excludes commercial users entirely
#   Reddit Data API      - new public access closed 31 Oct 2026
#   Instagram Graph API  - cannot search public posts it does not own
#   X API                - pay-per-use, no free tier
# ---------------------------------------------------------------------------
# X_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=
